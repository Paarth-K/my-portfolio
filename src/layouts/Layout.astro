    <meta property="og:url" content="https://www.paarthk.dev/" />
    <meta property="og:type" content="profile" />
    <meta
      property="og:image"
      content="https://cdn.paarthk.dev/?url=www.paarthk.dev/paarth-k-og-image.png&w=1000"
    />
    <meta property="og:image:width" content="1000" />
    <meta property="og:image:height" content="647" />
    <link rel="canonical" href="https://www.paarthk.dev/" />
    <meta property="og:image:alt" content="Paarth's Portfolio site logo" />

    <script type="application/ld+json">
