---
import OSN from "./OSN/OSN";
import TH from "./TH/TH";
---

<div class="ExperienceGrid" id="experience">
  <div class="ExperienceTitle">
    <span>Experience</span>
  </div>
  <div class="ExperienceInfo">
    <OSN client:visible />
    <TH client:visible />
  </div>
</div>

<style lang="scss">
  .ExperienceGrid {
    display: grid;
    grid-template-columns: min-content minmax(0, auto);
    column-gap: var(--rail-gap);
    margin-left: var(--gutter);
    margin-right: var(--gutter);
  }
  .ExperienceTitle {
    display: inline-grid;
    writing-mode: vertical-rl;
    // Hugs the em so rails of different sizes share one edge.
    line-height: 1;
    font-size: var(--type-rail);
    color: var(--ink-strong);
    place-items: center;
    top: 30%;
    position: sticky;
    align-self: flex-start;
  }
  @media (max-width: 630px) {
    .ExperienceTitle {
      top: 45%;
    }
  }
</style>
