---
import AboutSection from "../AboutSection/AboutSection.jsx";
import LandingPage from "../LandingPage/LandingPage.astro";
import ProjectsSection from "../ProjectsSection/ProjectsSection.jsx";
import Experiences from "../Experiences/Experiences.astro";
import Countries from "../Countries/Countries.astro";
import Education from "../Education/Education.astro";
import Footer from "../Footer/Footer.jsx";
---

<div>
  <LandingPage />

  <div class="landing-runway"></div>

  <AboutSection client:visible />

  <ProjectsSection />

  <Experiences />

  <Countries />

  <Education />

  <Footer client:load />
</div>

<style>
  /*
   * Scroll runway for the landing: the title hands off from fixed to
   * absolute at 600px and the drifting marks are placed down to 1200px,
   * so the first section must not start before that.
   */
  .landing-runway {
    height: 1300px;
  }
</style>
