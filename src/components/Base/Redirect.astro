---
export interface Props {
  /** Where the visitor is being sent. */
  to: string;
  /** Page title, e.g. "Redirecting to Source Code". */
  title: string;
  /** Sentence describing the destination, e.g. "the source code of this site". */
  destination: string;
}

const { to, title, destination } = Astro.props;
---

<html lang="en">
  <head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-2PWJ5Z5RY1"
    ></script>
    <script type="text/javascript">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-2PWJ5Z5RY1");
    </script>
    <meta charset="UTF-8" />
    <!-- A redirect stub is not a destination; keep it out of the index. -->
    <meta name="robots" content="noindex, follow" />
    <link
      rel="icon"
      type="image/png"
      href="/icons/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
    <link rel="shortcut icon" href="/icons/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/icons/apple-touch-icon.png"
    />
    <meta name="apple-mobile-web-app-title" content="Paarth" />
    <link rel="manifest" href="/icons/site.webmanifest" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7fdf9" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400..500&display=swap"
      rel="stylesheet"
    />
    <meta http-equiv="refresh" content={`0;url=${to}`} />
    <title>{title}</title>
    <script type="text/javascript">
      (function (c, l, a, r, i, t, y) {
        c[a] =
          c[a] ||
          function () {
            (c[a].q = c[a].q || []).push(arguments);
          };
        t = l.createElement(r);
        t.async = 1;
        t.src = "https://www.clarity.ms/tag/" + i;
        y = l.getElementsByTagName(r)[0];
        y.parentNode.insertBefore(t, y);
      })(window, document, "clarity", "script", "hui597fchn");
    </script>
  </head>
  <body>
    <main>
      <p class="lede">Taking you to {destination}&hellip;</p>
      <p class="fallback">
        If nothing happens, <a href={to}>continue manually</a>.
      </p>
      <p class="back"><a href="/">Back to paarthk.dev</a></p>
    </main>
  </body>
</html>

<style is:global>
  :root {
    --background: #f7fdf9;
    --secondary: #ff5900;
    --text-col: #0b181e;
    --ink-muted: #565656;
  }

  html,
  body {
    height: 100%;
    margin: 0;
  }

  body {
    display: grid;
    place-items: center;
    padding: 2rem;
    background-color: var(--background);
    color: var(--text-col);
    font-family: "DM Sans", sans-serif;
    text-align: center;
  }

  main {
    max-width: 34ch;
  }

  .lede {
    font-size: clamp(1.4rem, 1.15rem + 1vw, 1.9rem);
    font-weight: 500;
    line-height: 1.3;
    margin: 0 0 0.75rem;
  }

  .fallback,
  .back {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--ink-muted);
    margin: 0 0 0.5rem;
  }

  a {
    color: var(--text-col);
    text-decoration-color: rgba(11, 24, 30, 0.35);
    text-underline-offset: 4px;
    transition: color 0.2s ease;
  }

  a:hover,
  a:focus-visible {
    color: var(--secondary);
    text-decoration-color: currentColor;
  }

  :focus-visible {
    outline: 2px solid var(--secondary);
    outline-offset: 3px;
    border-radius: 4px;
  }
</style>
