---
import Dubai from "./Dubai/Dubai.jsx";
import Singapore from "./Singapore/Singapore.jsx";
---

<div class="CountriesGrid" id="countries">
  <div class="CountriesInfo">
    <Dubai client:visible />
    <Singapore client:visible />
  </div>
  <div class="CountriesTitle">
    <span>Countries</span>
  </div>
</div>

<style lang="scss">
  .CountriesGrid {
    display: grid;
    grid-template-columns: minmax(0, auto) min-content;
    column-gap: var(--rail-gap);
    margin-right: var(--gutter);
  }
  .CountriesTitle {
    display: inline-grid;
    writing-mode: vertical-rl;
    // Hugs the em so rails of different sizes share one edge.
    line-height: 1;
    font-size: var(--type-rail);
    color: var(--ink-strong);
    place-items: center;
    top: 30%;
    position: sticky;
    align-self: flex-start;
  }
  @media (max-width: 630px) {
    .CountriesTitle {
      top: 45%;
    }
  }
</style>
