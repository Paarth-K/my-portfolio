---
import DCIS from "./DCIS/DCIS";
import NLCS from "./NLCS/NLCS";
---

<div class="EducationGrid" id="education">
  <div class="EducationTitle">
    <span>Education</span>
  </div>
  <div class="EducationInfo">
    <NLCS client:visible />
    <DCIS client:visible />
  </div>
</div>

<style lang="scss">
  .EducationGrid {
    display: grid;
    grid-template-columns: min-content minmax(0, auto);
    column-gap: var(--rail-gap);
    margin-left: var(--gutter);
    margin-right: var(--gutter);
  }
  .EducationTitle {
    display: inline-grid;
    writing-mode: vertical-rl;
    // Hugs the em so rails of different sizes share one edge.
    line-height: 1;
    font-size: var(--type-rail);
    color: var(--ink-strong);
    place-items: center;
    top: 30%;
    position: sticky;
    align-self: flex-start;
  }
  @media (max-width: 630px) {
    .EducationTitle {
      top: 45%;
    }
  }
</style>
