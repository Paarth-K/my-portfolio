---
import DCIS from "./DCIS/DCIS";
import NLCS from "./NLCS/NLCS";
---

<div class="EducationGrid" id="education">
  <div class="EducationTitle" data-rail>
    <span>Education</span>
  </div>
  <div class="EducationInfo">
    <NLCS client:visible />
    <DCIS client:visible />
  </div>
</div>

<style lang="scss">
  .EducationGrid {
    display: grid;
    grid-template-columns: var(--rail) minmax(0, auto);
    column-gap: var(--rail-gap);
    margin-left: var(--gutter);
    margin-right: var(--gutter);
  }
  .EducationTitle {
    display: inline-grid;
    writing-mode: vertical-rl;
    // Identical track + centred + tight line box = one shared axis.
    line-height: 1;
    justify-self: center;
    font-size: var(--type-rail);
    color: var(--ink-strong);
    place-items: center;
    // Plain sticky: starts at the top of its section, stops near the
    // centre of the screen, and is pushed out by the section's end.
    position: sticky;
    // Exact stop: midpoint of the word on the midpoint of the screen.
    // --rail-half is half this word's measured height, set by the small
    // script in Layout.astro; the fallback approximates until it runs.
    top: calc(50dvh - var(--rail-half, 25dvh));
    align-self: start;
  }
</style>
